{
  "$schema": "https://nx.dev/reference/nx-json#workspace-configuration",
  "useDaemonProcess": true,
  "parallel": 30,
  "defaultBase": "main",
  "plugins": [
    "@nx/js"
  ],
  "release": {
    "projectsRelationship": "independent",
    "projects": [
      "@0noxtackore/core",
      "@0noxtackore/client",
      "@0noxtackore/encoder",
      "@0noxtackore/proto",
      "create-ag-ui-app",
      "@0noxtackore/a2ui-toolkit",
      "@0noxtackore/a2a",
      "@0noxtackore/adk",
      "@0noxtackore/adk-js",
      "@0noxtackore/ag2",
      "@0noxtackore/agno",
      "@0noxtackore/antigravity",
      "@0noxtackore/aws-strands",
      "@0noxtackore/claude-agent-sdk",
      "@0noxtackore/claude-managed-agents",
      "@0noxtackore/cloudflare-agents",
      "@0noxtackore/crewai",
      "@0noxtackore/langchain",
      "@0noxtackore/langgraph",
      "@0noxtackore/llamaindex",
      "@0noxtackore/mastra",
      "@0noxtackore/omnara",
      "@0noxtackore/openai-agents",
      "@0noxtackore/pydantic-ai",
      "@0noxtackore/spring-ai",
      "@0noxtackore/watsonx",
      "@0noxtackore/a2a-middleware",
      "@0noxtackore/a2ui-middleware",
      "@0noxtackore/mcp-apps-middleware",
      "@0noxtackore/mcp-middleware"
    ]
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).ts",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/vitest.config.mts"
    ]
  },
  "targetDefaults": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/.next"
      ],
      "cache": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "dev": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "cache": false
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "test:coverage": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "cache": true
    },
    "test:watch": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "link:global": {
      "cache": false
    },
    "unlink:global": {
      "cache": false
    },
    "start": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  }
}
